# copy to .env (ignored by git) and fill in. `source .env` before running the scripts.
# never put a private key in here: import it once with `cast wallet import <name> --interactive`
# and pass `--account <name>` to forge script.

# rpc endpoints (foundry.toml reads these)
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# --- script/Deploy.s.sol ---
# chainlink vrf v2.5 subscription owned by the deployer (script/CreateVrfSubscription.s.sol or vrf.chain.link)
VRF_SUBSCRIPTION_ID=
# optional, default: the deployer
ADMIN=
FEE_TREASURY=
# optional: LINK in wei the deployer funds the subscription with, e.g. 5000000000000000000 for 5 LINK
VRF_FUND_LINK=

# --- script/CreatePool.s.sol ---
POOL_MANAGER=
